# PostgreSQL Warehouse Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics_warehouse
DB_USER=warehouse_admin
DB_PASSWORD=admin_password

# Database Mode: postgresql or sqlite
DB_TYPE=sqlite
SQLITE_DB_PATH=data/analytics_warehouse.db

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=my-ecommerce-data-pipeline-bucket
S3_RAW_PREFIX=raw/
S3_PROCESSED_PREFIX=processed/

# Pipeline Settings
LOG_LEVEL=INFO
BATCH_SIZE=5000
USE_S3_MOCK=true
